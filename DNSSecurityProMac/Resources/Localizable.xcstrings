    "DNS over HTTPS requires an https:// endpoint URL. Bootstrap servers are optional.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS over HTTPS 需要 https:// 端點網址；Bootstrap 伺服器可留空。"
          }
        }
      }
    },
    "DNS over TLS requires a certificate server name and at least one bootstrap server.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS over TLS 需要憑證伺服器名稱及至少一個 Bootstrap 伺服器。"
          }
        }
      }
    },
    "DNS over TLS requires at least one bootstrap server address.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS over TLS 至少需要一個 Bootstrap 伺服器位址。"
          }
        }
      }
    },
