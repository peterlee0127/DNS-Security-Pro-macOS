          }
        }
      }
    },
    "TLS Server Name": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS 伺服器名稱"
          }
        }
      }
    },
    "Use This Profile": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此設定"
          }
        }
      }
    },
    "Version %@ (%@)": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 %@（%@）"
          }
        }
      }
    },
    "Tutorial": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "教學"
          }
        }
      }
    },
    "Set Up Encrypted DNS": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定加密 DNS"
          }
        }
      }
    },
    "Follow these five steps. You normally need to approve the configuration only the first time.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依照以下五個步驟操作。通常只有第一次需要核准此設定。"
          }
        }
      }
    },
    "Choose a DNS profile": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 DNS 設定"
          }
        }
      }
    },
    "Open DNS Profiles and select a built-in resolver, or add your own DoH or DoT profile.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「DNS 設定」，選擇內建解析器，或加入自己的 DoH 或 DoT 設定。"
          }
        }
      }
    },
    "Connect encrypted DNS": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接加密 DNS"
          }
        }
      }
    },
    "Return to Dashboard and choose Connect. DNS Security Pro installs the selected encrypted DNS configuration.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "返回「儀表板」並選擇「連線」。DNS Security Pro 會安裝選取的加密 DNS 設定。"
          }
        }
      }
    },
    "Approve macOS": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核准 macOS"
          }
        }
      }
    },
    "In System Settings, open Network → VPN & Filters → DNS Security Pro, then approve the DNS configuration.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「系統設定」中依序開啟「網路」→「VPN 與過濾條件」→「DNS Security Pro」，然後核准 DNS 設定。"
          }
        }
      }
    },
    "Confirm protection": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認保護狀態"
          }
        }
      }
    },
    "Refresh DNS status if needed. A green shield and “Encrypted DNS is active” confirm that the profile is enabled.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如有需要，請重新整理 DNS 狀態。綠色盾牌及「加密 DNS 已啟用」代表設定已生效。"
          }
        }
      }
    },
    "Choose how the app stays available": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 App 的常駐方式"
          }
        }
      }
    },
    "Keep the menu bar control enabled, or hide it and optionally quit after successful DNS changes.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留選單列控制，或將它隱藏，並選擇是否在成功變更 DNS 後結束 App。"
          }
        }
      }
    },
    "Good to know": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小提醒"
          }
        }
      }
    },
    "Closing DNS Security Pro does not disable an installed profile. Choose Disconnect on Dashboard when you want to return to the system DNS.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉 DNS Security Pro 不會停用已安裝的設定。要恢復使用系統 DNS，請在「儀表板」選擇「中斷連線」。"
          }
        }
      }
    },
    "Reading the current macOS DNS configuration.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在讀取目前的 macOS DNS 設定。"
          }
        }
      }
    },
    "DNS status is unavailable": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取得 DNS 狀態"
          }
        }
      }
    },
    "Refresh to read the current macOS DNS configuration again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新整理，以再次讀取目前的 macOS DNS 設定。"
          }
        }
      }
    },
    "Try Again": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再試一次"
          }
        }
      }
    },
    "Enter valid IPv4 or IPv6 addresses for bootstrap servers.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入有效的 IPv4 或 IPv6 位址作為 Bootstrap 伺服器。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
