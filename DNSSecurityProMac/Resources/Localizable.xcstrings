{
  "sourceLanguage": "en",
  "strings": {
    "Built-in": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內建"
          }
        }
      }
    }
,
    "Choose a profile from the list to view its settings.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從清單選擇一個設定以查看詳細內容。"
          }
        }
      }
    }
,
    "Choose what DNS Security Pro does after you apply a DNS change.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇套用 DNS 變更後 DNS Security Pro 的運作方式。"
          }
        }
      }
    }
,
    "Connect when you want to use this profile.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要使用此設定時再連線。"
          }
        }
      }
    }
,
    "Copy": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製"
          }
        }
      }
    }
,
    "Custom": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂"
          }
        }
      }
    }
,
    "Details": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細資訊"
          }
        }
      }
    }
,
    "Manage built-in profiles or edit your custom resolvers.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "管理內建設定或編輯自訂解析器。"
          }
        }
      }
    },
    "Private DNS on Wi-Fi, Ethernet, and every macOS network interface.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Wi-Fi、乙太網路及所有 macOS 網路介面使用私密 DNS。"
          }
        }
      }
    }
,
    "Profile Details": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定詳細資訊"
          }
        }
      }
    }
,
    "Revert Changes": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還原變更"
          }
        }
      }
    }
,
    "Save & Use Profile": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存並使用設定"
          }
        }
      }
    }
,
    "Save Changes": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存變更"
          }
        }
      }
    }
,
    "Select a DNS profile": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 DNS 設定"
          }
        }
      }
    }
,
    "Switch DNS Profile": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換 DNS 設定"
          }
        }
      }
    }
,
    "System approval may be required the first time you connect.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次連線時可能需要系統核准。"
          }
        }
      }
    }
,
    "System Settings → Network → VPN & Filters → DNS Security Pro": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統設定 → 網路 → VPN 與過濾條件 → DNS Security Pro"
          }
        }
      }
    },
    "This built-in profile is read-only.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此內建設定為唯讀。"
          }
        }
      }
    }
,
    "You can always reopen the app to change or disable the installed profile.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您隨時可以重新開啟 App，以變更或停用已安裝的設定。"
          }
        }
      }
    }
,
    "Your Mac is protected by the selected encrypted DNS profile.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 正受到所選加密 DNS 設定的保護。"
          }
        }
      }
    }
,
    "%@ · %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        }
      }
    },
      "App Behavior": {
        "localizations": {
          "zh-Hant": {
            "stringUnit": {
              "state": "translated",
              "value": "App 行為"
            }
          }
        }
      },
      "Connect DNS": {
        "localizations": {
          "zh-Hant": {
            "stringUnit": {
              "state": "translated",
              "value": "連接 DNS"
            }
          }
        }
      },
      "Keep quick DNS controls available after closing the main window.": {
        "localizations": {
          "zh-Hant": {
            "stringUnit": {
              "state": "translated",
              "value": "關閉主視窗後，仍可從選單列快速控制 DNS。"
            }
          }
        }
      },
      "Menu Bar": {
        "localizations": {
          "zh-Hant": {
            "stringUnit": {
              "state": "translated",
              "value": "選單列"
            }
          }
        }
      },
      "Open DNS Security Pro": {
        "localizations": {
          "zh-Hant": {
            "stringUnit": {
              "state": "translated",
              "value": "開啟 DNS Security Pro"
            }
          }
        }
      },
      "Quit DNS Security Pro": {
        "localizations": {
          "zh-Hant": {
            "stringUnit": {
              "state": "translated",
              "value": "結束 DNS Security Pro"
            }
          }
        }
      },
      "Quit after applying DNS changes": {
        "localizations": {
          "zh-Hant": {
            "stringUnit": {
              "state": "translated",
              "value": "套用 DNS 變更後結束 App"
            }
          }
        }
      },
      "Settings": {
        "localizations": {
          "zh-Hant": {
            "stringUnit": {
              "state": "translated",
              "value": "設定"
            }
          }
        }
      },
      "Settings…": {
        "localizations": {
          "zh-Hant": {
            "stringUnit": {
              "state": "translated",
              "value": "設定…"
            }
          }
        }
      },
      "Show DNS Security Pro in the menu bar": {
        "localizations": {
          "zh-Hant": {
            "stringUnit": {
              "state": "translated",
              "value": "在選單列顯示 DNS Security Pro"
            }
          }
        }
      },
      "The installed DNS profile remains active after the app quits.": {
        "localizations": {
          "zh-Hant": {
            "stringUnit": {
              "state": "translated",
              "value": "App 結束後，已安裝的 DNS 設定仍會保持啟用。"
            }
          }
        }
      },
    "A focused, native SwiftUI app for switching system-wide encrypted DNS profiles on macOS. No Mac Catalyst or embedded iOS interface.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "專為 macOS 打造的原生 SwiftUI 加密 DNS 設定切換工具，不使用 Mac Catalyst，也不嵌入 iOS 介面。"
          }
        }
      }
    },
    "A profile with the same name and protocol already exists.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有相同名稱與通訊協定的設定。"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關於"
          }
        }
      }
    },
    "Selected Profile": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取的設定"
          }
        }
      }
    },
    "Add Profile": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增設定"
          }
        }
      }
    },
    "Open System Settings → Network → VPN & Filters → DNS Security Pro, approve the configuration, then return and refresh the status.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請前往「系統設定」→「網路」→「VPN 與過濾條件」→「DNS Security Pro」核准設定，返回後再重新整理狀態。"
          }
        }
      }
    },
    "Approval Required": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要核准"
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動"
          }
        }
      }
    },
